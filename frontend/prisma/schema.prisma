generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id            String       @id @default(cuid())
  name          String?
  email         String?      @unique
  emailVerified DateTime?
  image         String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  university    String?
  faculty       String?
  department    String?
  speciality    String?
  discipline    String?
  course        String?
  groupNumber   String?
  fullName      String?
  teacherName   String?
  city          String?
  role          String       @default("user")
  banned        Boolean      @default(false)
  password      String?
  /// Первый/последний предпросмотр (дата; совместимость со старой схемой)
  freePreviewUsedAt DateTime?
  /// Сколько бесплатных предпросмотров уже использовано
  freePreviewUses   Int      @default(0)
  /// Лимит бесплатных предпросмотров до оплаты (по умолчанию 1)
  freePreviewQuota  Int      @default(1)
  accounts      Account[]
  generations   Generation[]
  payments      Payment[]
  sessions      Session[]
  extrasJobs    ExtrasJob[]
  workActivities WorkActivity[]
  previewTasks   PreviewTask[]
}

/// Черновик заказа до оплаты (страница /tasks/[id])
model PreviewTask {
  id        String   @id @default(cuid())
  userId    String
  topic     String
  workType  String
  pages     Int      @default(20)
  extras    String?
  createdAt DateTime @default(now())
  expiresAt DateTime
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Generation {
  id               String            @id @default(cuid())
  userId           String
  createdAt        DateTime          @default(now())
  topic            String
  pages            Int
  workType         String            @default("Реферат")
  status           String            @default("completed")
  result           String
  isPublic         Boolean           @default(true)
  slug             String?           @unique
  /// Ручная отметка: страница в выдаче Google (site: URL); null — не решено.
  adminInSearchGoogle  Boolean?
  /// Ручная отметка: страница в выдаче Яндекса; null — не решено.
  adminInSearchYandex  Boolean?
  extras           String?
  rating           Int?
  feedbackComments FeedbackComment[]
  workActivities    WorkActivity[]
  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// Журнал скачиваний работ (DOCX/PPTX/Speech) для поддержки и аналитики
model WorkActivity {
  id            String      @id @default(cuid())
  userId        String
  generationId  String?
  action        String
  source        String
  slug          String?
  workType      String?
  meta          String?
  createdAt     DateTime    @default(now())
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  generation    Generation? @relation(fields: [generationId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([generationId])
  @@index([action, createdAt])
}

model FeedbackComment {
  id           String     @id @default(cuid())
  generationId String
  issues       String
  comment      String?
  createdAt    DateTime   @default(now())
  generation   Generation @relation(fields: [generationId], references: [id], onDelete: Cascade)
}

model SeoPage {
  id              Int      @id @default(autoincrement())
  slug            String   @unique
  workType        String
  subject         String
  title           String
  metaTitle       String
  metaDescription String
  previewText     String
  bodyText        String   @default("")
  adminInSearchGoogle Boolean?
  adminInSearchYandex Boolean?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @default(now()) @updatedAt
}

model Payment {
  id        String    @id @default(cuid())
  userId    String
  workType  String
  amount    Int
  status    String    @default("pending")
  provider  String    @default("yookassa")
  providerPaymentId String?
  yokassaId String?
  createdAt DateTime  @default(now())
  usedAt    DateTime?
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([provider, providerPaymentId])
}

model ExtrasJob {
  id        String   @id
  userId    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}
